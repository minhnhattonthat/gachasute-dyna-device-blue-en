  "status": "todo"
 },
 {
  "id": "s756.09",
  "flag": 0,
  "speaker": 1,
  "jp": "{%sR4}くん\nこんどは　キミとなんだね{KP}\nよーし　ちょっと　ホンキ\nだしちゃおっかなー・・・なんてねっ",
