[
 {
  "id": "s750.00",
  "flag": 0,
  "speaker": 4,
  "jp": "{%sR4}さん\nだいじょうぶですか？",
  "en": "{%sR4}-san, are you all right?",
  "status": "done"
 },
 {
  "id": "s750.01",
  "flag": 0,
  "speaker": 4,
  "jp": "ウォータータイプの　セクタどうしは\nとなりあうと　つながってしまうので",
  "en": "Water sectors join up when they are next\nto each other,",
  "status": "done"
 },
 {
  "id": "s750.02",
  "flag": 0,
  "speaker": 4,
  "jp": "なかに　とじこめられてしまうことが\nあるんです",
  "en": "so you can end up shut inside them.",
  "status": "done"
 },
 {
  "id": "s750.03",
  "flag": 0,
  "speaker": 4,
  "jp": "また　バーディスや　シェルブックタイプの\nダイナに　のって",
  "en": "Also, when you are riding a Dyna of the\nBirdis type or Shellbook type",
  "status": "done"
 },
 {
  "id": "s750.04",
  "flag": 0,
  "speaker": 4,
  "jp": "ウォータータイプの　セクタの　うえを\nいどうしているときも",
  "en": "and moving over a Water sector,",
  "status": "done"
 },
 {
  "id": "s750.05",
  "flag": 0,
  "speaker": 4,
  "jp": "なんらかの　りゆうで\nダイナが　いなくなると",
  "en": "if the Dyna goes away for some reason,",
  "status": "done"
 },
 {
  "id": "s750.06",
  "flag": 0,
  "speaker": 4,
  "jp": "ウォーターの　セクタの　なかに\nとじこめられてしまいます",
  "en": "you will be shut inside the Water sector.",
  "status": "done"
 },
 {
  "id": "s750.07",
  "flag": 0,
  "speaker": 4,
  "jp": "そうすると　いまのように\nここに　てんそうされてしまって",
  "en": "When that happens, you get sent back\nhere, like just now,",
  "status": "done"
 },
 {
  "id": "s750.08",
  "flag": 0,
  "speaker": 4,
  "jp": "つれている　ダイナの\nきげんが　わるくなってしまいます{KP}\nこんごは　きをつけてくださいね",
  "en": "and the Dyna you have with you get\ngrumpy.{KP}\nPlease be careful from now on.",
  "status": "done"
 },
 {
  "id": "s751.00",
  "flag": 0,
  "speaker": -1,
  "jp": "{%sR0}は　ちからつきて\nダイナセンターに　てんそうされました",
  "en": "{%sR0} collapsed and was sent to\nthe Dyna Center.",
  "status": "done"
 },
 {
  "id": "s752.00",
  "flag": 0,
  "speaker": -1,
  "jp": "{%sR0}は　ちからつきて\nダイナセンターに　てんそうされました",
  "en": "{%sR0} collapsed and was sent to\nthe Dyna Center.",
  "status": "done"
 },
 {
  "id": "s752.01",
  "flag": 0,
  "speaker": -1,
  "jp": "これにより　〒{%02dR1}－{%02dR2}　ハウスは\nあきやに　なりました",
  "en": "Because of this, the House at {%02dR1}-{%02dR2} is\nnow empty.",
  "status": "done"
 },
 {
  "id": "s753.00",
  "flag": 0,
  "speaker": 4,
  "jp": "{%sR4}さん\nだいじょうぶですか？",
  "en": "{%sR4}-san, are you all right?",
  "status": "done"
 },
 {
  "id": "s753.01",
  "flag": 0,
  "speaker": 4,
  "jp": "ダイナシティを　ダイナなしで\nあるくのは　たいへん　キケンなので",
  "en": "Walking around Dyna City without a Dyna is\nvery dangerous,",
  "status": "done"
 },
 {
  "id": "s753.02",
  "flag": 0,
  "speaker": 4,
  "jp": "もうしわけありませんが　ここへ\nかってに　てんそうさせていただきました",
  "en": "",
  "status": "todo"
 },
 {
  "id": "s753.03",
  "flag": 0,
  "speaker": 4,
  "jp": "そのときの　むりな　てんそうが\nげんいんで　データが　いちぶ　こわれて",
  "en": "",
  "status": "todo"
 },
 {
  "id": "s753.04",
  "flag": 0,
  "speaker": 4,
  "jp": "てもちビットが　はんぶんに\nなってしまったようなのですが",
  "en": "",
  "status": "todo"
 },
 {
  "id": "s753.05",
  "flag": 0,
  "speaker": 4,
  "jp": "きんきゅうじたいだったので\nおゆるしください",
  "en": "",
  "status": "todo"
 },
 {
  "id": "s753.06",
  "flag": 0,
  "speaker": 4,
  "jp": "さきほど　つれていた　ダイナは\nかいふくさせておきました",
  "en": "",
  "status": "todo"
 },
 {
  "id": "s753.07",
  "flag": 0,
  "speaker": 4,
  "jp": "これからは　ダイナたちの　ＨＰが\nなくならないように　きをつけてくださいね",
  "en": "",
  "status": "todo"
 },
 {
  "id": "s754.00",
  "flag": 0,
  "speaker": 4,
  "jp": "{%sR4}さん　きこえますか？\nわたしです　ナビュウです",
  "en": "",
  "status": "todo"
 },
 {
  "id": "s754.01",
  "flag": 0,
  "speaker": 4,
  "jp": "もうすぐ　スタジアムにて　こうれいの\nバトルたいかいが　おこなわれます",
  "en": "",
  "status": "todo"
 },
 {
  "id": "s754.02",
  "flag": 0,
  "speaker": 4,
  "jp": "バトルに　さんかさせたい　ダイナの\nじゅんびは　できていますか？",
  "en": "",
  "status": "todo"
 },
 {
  "id": "s754.03",
  "flag": 0,
  "speaker": 4,
  "jp": "さんかさせたい　ダイナは\nつれてあるいておいてくださいね",
  "en": "",
  "status": "todo"
 },
 {
  "id": "s755.00",
  "flag": 0,
  "speaker": 4,
  "jp": "{%sR4}さん　きこえますか？\nわたしです　ナビュウです{KP}\nいよいよ　バトルたいかいが　はじまります！",
  "en": "",
  "status": "todo"
 },
 {
  "id": "s755.01",
  "flag": 0,
  "speaker": 4,
  "jp": "スタジアムへは　ちかてつから\nいけるようになっていますので{KP}\nじゅんびができましたら　むかってくださいね",
  "en": "",
  "status": "todo"
 },
 {
  "id": "s756.00",
  "flag": 0,
  "speaker": 9,
  "jp": "さぁ！　まちにまった\nバトルたいかいの　はじまりです！",
  "en": "",
  "status": "todo"
 },
 {
  "id": "s756.01",
  "flag": 0,
  "speaker": 9,
  "jp": "ひごろから　きたえに　きたえた\nダイナの　ちからを{KP}\nぞんぶんに　はっきさせてください！",
  "en": "",
  "status": "todo"
 },
 {
  "id": "s756.02",
  "flag": 0,
  "speaker": 9,
  "jp": "それでは　１かいせんを\nかいしします！",
  "en": "",
  "status": "todo"
 },
 {
  "id": "s756.03",
  "flag": 0,
  "speaker": 9,
  "jp": "よろしくおねがいします！",
  "en": "",
  "status": "todo"
 },
 {
  "id": "s756.04",
  "flag": 0,
  "speaker": 10,
  "jp": "よろしくね！",
  "en": "",
  "status": "todo"
 },
 {
  "id": "s756.05",
  "flag": 0,
  "speaker": 2,
  "jp": "おお！　ついに　このときが　きたな！{KP}\nわが　えいえんの　ライバル\n{%sR4}よ！",
  "en": "",
  "status": "todo"
 },
 {
  "id": "s756.06",
  "flag": 0,
  "speaker": 2,
  "jp": "いくぜ！　オレさまの　ほんとうの\nちからを　みせてやる！",
  "en": "",
  "status": "todo"
 },
 {
  "id": "s756.07",
  "flag": 0,
  "speaker": 15,
  "jp": "ああっ　{%sR4}！\nげんきだったぁ？",
  "en": "",
  "status": "todo"
 },
 {
  "id": "s756.08",
  "flag": 0,
  "speaker": 15,
  "jp": "わたくしぃ　{%sR4}との\nバトルってぇ・・・たのしいから　スキぃ{KP}\nじゃぁ　いっくよぉぉぉぉ！",
